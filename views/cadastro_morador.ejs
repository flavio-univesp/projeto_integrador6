<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cadastro de Morador</title>
  <link rel="stylesheet" href="/cadastro_morador/style.css">
</head>
<body>
  <div class="page-shell">
    <header class="topbar">
      <a href="/home" class="back-link">← Voltar</a>
      <h1>Cadastro de Morador</h1>
    </header>

    <main class="form-card">
      <% if (error) { %>
        <div class="message error"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="message success"><%= success %></div>
      <% } %>

      <form action="/cadastro-morador" method="POST">
        <div class="field-grid">
          <label>
            Nome completo
            <input type="text" name="nome" required>
          </label>

          <label>
            E-mail
            <input type="email" name="email" autocomplete="email" maxlength="150" pattern="^[^\s@]+@[^\s@]+\.[^\s@]+$" title="Informe um e-mail válido, como usuario@dominio.com" aria-describedby="email-status" required>
            <span id="email-status" class="field-status" aria-live="polite"></span>
          </label>

          <label>
            Senha
            <input type="password" name="senha" aria-describedby="senha-status" required>
            <span id="senha-status" class="field-status" aria-live="polite"></span>
          </label>

          <label>
            Telefone
            <input type="tel" name="telefone" inputmode="numeric" autocomplete="tel" maxlength="15" pattern="\(\d{2}\) \d{4,5}-\d{4}" title="Informe um telefone com 10 ou 11 dígitos">
          </label>

          <label>
            Sexo
            <select name="genero">
              <option value="">Selecione</option>
              <option value="Masculino">Masculino</option>
              <option value="Feminino">Feminino</option>
              <option value="Outro">Outro</option>
            </select>
          </label>

          <label>
            Data de nascimento
            <input type="date" name="datanasc">
          </label>

          <label>
            CEP
            <input type="text" name="cep" inputmode="numeric" autocomplete="postal-code" maxlength="9" aria-describedby="cep-status">
            <span id="cep-status" class="field-status" aria-live="polite"></span>
          </label>

          <label>
            Endereço
            <input type="text" name="endereco" readonly aria-readonly="true">
          </label>

          <label>
            Número
            <input type="text" name="numero">
          </label>

          <label>
            Cidade
            <input type="text" name="cidade" readonly aria-readonly="true">
          </label>

          <label>
            Estado
            <input type="text" name="estado" readonly aria-readonly="true">
          </label>

          <label>
            Complemento
            <input type="text" name="complemento">
          </label>
        </div>

        <button type="submit" class="submit-button">Cadastrar</button>
      </form>
    </main>
  </div>
  <script src="/cadastro_morador/script.js" defer></script>
</body>
</html>
